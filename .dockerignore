# Dependencies and build output — re-created inside the image.
node_modules
apps/web/node_modules
apps/web/.next
apps/web/out
apps/api/dropd
apps/api/bin

# Local state: the SQLite file, the MinIO-backed object cache, and the RS256
# signing keypair. The keys especially must never be baked into an image.
apps/api/dropstore
apps/api/certs
**/*.db
**/*.db-shm
**/*.db-wal

# Secrets and machine-local config.
**/.env
**/.env.local
**/.env.*.local

# Not part of any build.
.git
.github
.claude
.agents
agent
docs
graphify-out
scripts
e2e
**/*.tsbuildinfo
**/*.log
.DS_Store
