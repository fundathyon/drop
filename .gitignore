# Go API
/api/dropd
/api/drop.db
/api/dropstore/
/api/.env
/.env

# Local editor config — launch.json ends up holding real secrets (signing
# keys, admin credentials) when debugging locally.
/.vscode/

# Token signing keys — generated by `make keys`. Committing a signing key
# hands it to everyone who ever cloned the repo.
/api/certs/

# Knowledge-graph output: regenerated by the graphify skill, ~2 MB of
# derived JSON plus its AST/semantic caches.
graphify-out/

*.log
