# Go API
/api/dropd
/api/drop.db
/api/dropstore/
/api/.env

# Admin build staged for go:embed — produced by `make admin`, never edited by
# hand. The directory itself must survive, or go:embed fails to compile.
/api/internal/adminui/dist/*
!/api/internal/adminui/dist/.gitkeep

# Astro frontend (web/ ships its own .gitignore too)
/web/dist/
/web/node_modules/
/web/.astro/
/web/.env

# Knowledge-graph output: regenerated by the graphify skill, ~2 MB of
# derived JSON plus its AST/semantic caches.
graphify-out/

*.log
