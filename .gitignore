# Go API
/apps/api/dropd
/apps/api/dropstore/
/apps/api/.env
/.env

# SQLite database plus the -wal/-shm sidecars it writes next to it. Local
# state, never shared: `make reset` deletes these to replay the setup wizard.
*.db
*.db-wal
*.db-shm

# Bun workspace: with workspaces the real package store is hoisted to the
# repo root and apps/web/node_modules is only symlinks into it, so this has
# to be ignored here and not just in apps/web/.gitignore.
/node_modules/

# Local editor config — launch.json ends up holding real secrets (signing
# keys, admin credentials) when debugging locally.
/.vscode/

# Token signing keys — generated by `make keys`. Committing a signing key
# hands it to everyone who ever cloned the repo.
/apps/api/certs/

# Knowledge-graph output: regenerated by the graphify skill, ~2 MB of
# derived JSON plus its AST/semantic caches.
graphify-out/

*.log
